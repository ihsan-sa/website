exports[`the front page is unchanged 1`] = `"<main class=\\"pv\\"><nav class=\\"pv-links\\" aria-label=\\"Contact and profiles\\"><a class=\\"pv-link\\" href=\\"mailto:hi@ihsan.cc\\">hi@ihsan.cc</a><a class=\\"pv-link\\" href=\\"https://github.com/ihsan-sa\\" target=\\"_blank\\" rel=\\"noopener noreferrer\\">GitHub</a><a class=\\"pv-link\\" href=\\"https://linkedin.com/in/ihsan-sa\\" target=\\"_blank\\" rel=\\"noopener noreferrer\\">LinkedIn</a><a class=\\"pv-link\\" href=\\"/images/Ihsan_Salari_Resume.pdf\\" target=\\"_blank\\" rel=\\"noopener noreferrer\\">Résumé</a><a class=\\"pv-link\\" href=\\"/images/Ihsan_Salari_Portfolio.pdf\\" target=\\"_blank\\" rel=\\"noopener noreferrer\\">Portfolio</a><a class=\\"pv-link\\" href=\\"/images/Salari_Ihsan_Contact_Card.vcf\\" download=\\"\\">Contact card</a><button type=\\"button\\" class=\\"pv-link pv-toggle\\" aria-pressed=\\"false\\" aria-label=\\"Switch to Dark theme\\">Dark</button></nav><header class=\\"pv-intro\\"><h1 class=\\"pv-name\\">Ihsan Salari</h1><p>UWaterloo EE student building AI systems, with experience in signal integrity, datacenter optics, and RF for chip manufacturing.</p><p>Engineering overlooks ethics and social impact far too often. I treat them as core to my work, along with environmental sustainability, and AI makes that matter more.</p><p>Every role I’ve held was in a field new to me, and each time I owned critical deliverables within weeks.</p></header><section class=\\"pv-block\\"><h2>Experience</h2><p><strong class=\\"pv-strong\\">Fab2 (Atomic Semi)</strong>, RF for plasma generation. Summer ’26.</p><p><strong class=\\"pv-strong\\">Arista Networks</strong>, SI and optics for AI datacenters. Fall ’25.</p><p><a class=\\"pv-strong\\" href=\\"https://docs.ihsan.cc/Projects/GaN_DCDC_Converter/overview/\\" target=\\"_blank\\" rel=\\"noopener noreferrer\\">aiRadar</a>, power electronics for multi‑beam sonar. Winter ’25.</p><p><strong class=\\"pv-strong\\">University of Waterloo</strong>, BASc Electrical Engineering. 2024–29.</p></section><section class=\\"pv-block\\"><h2>AI work</h2><p><a class=\\"pv-strong\\" href=\\"https://github.com/ihsan-sa/autobox\\" target=\\"_blank\\" rel=\\"noopener noreferrer\\">autobox</a>, an always‑on Claude Code agent box.<span> •&nbsp;<a class=\\"pv-link pv-doc\\" href=\\"/docs/autobox-pitch.pdf\\" target=\\"_blank\\" rel=\\"noopener noreferrer\\">Overview</a></span><span> •&nbsp;<a class=\\"pv-link pv-doc\\" href=\\"/docs/autobox-deeper-look.pdf\\" target=\\"_blank\\" rel=\\"noopener noreferrer\\">Deeper look</a></span><span> •&nbsp;<a class=\\"pv-link pv-doc\\" href=\\"/docs/agentic-systems-map.pdf\\" target=\\"_blank\\" rel=\\"noopener noreferrer\\">Map</a></span></p><p><a class=\\"pv-strong\\" href=\\"https://github.com/ihsan-sa/hwde\\" target=\\"_blank\\" rel=\\"noopener noreferrer\\">hwde</a>, an AI PCB engineer, from brief to fabricated board.<span> •&nbsp;<a class=\\"pv-link pv-doc\\" href=\\"/docs/hwde-showcase.pdf\\" target=\\"_blank\\" rel=\\"noopener noreferrer\\">Showcase</a></span></p><p><a class=\\"pv-strong\\" href=\\"/docs/chip-design-flow.pdf\\" target=\\"_blank\\" rel=\\"noopener noreferrer\\">chip design flow</a>, a proposal for digital, analog and mixed‑signal skills.<span> •&nbsp;<a class=\\"pv-link pv-doc\\" href=\\"/docs/chip-design-flow.pdf\\" target=\\"_blank\\" rel=\\"noopener noreferrer\\">Brief</a></span></p><p><a class=\\"pv-strong\\" href=\\"https://github.com/ihsan-sa/lesson-builder\\" target=\\"_blank\\" rel=\\"noopener noreferrer\\">lesson-builder</a>, course material into interactive lessons.<span> •&nbsp;<a class=\\"pv-link pv-doc\\" href=\\"/docs/lesson-builder-overview.pdf\\" target=\\"_blank\\" rel=\\"noopener noreferrer\\">Write-up</a></span></p></section><section class=\\"pv-block\\"><h2>Hardware</h2><div class=\\"pv-hw\\"><a class=\\"pv-hw__item\\" href=\\"https://docs.ihsan.cc/Projects/IonicThruster/overview/\\" target=\\"_blank\\" rel=\\"noopener noreferrer\\"><img class=\\"pv-hw__img\\" alt=\\"\\" loading=\\"lazy\\" src=\\"/images/ionic.jpg\\"><span>Ionic thruster</span></a><a class=\\"pv-hw__item\\" href=\\"https://docs.ihsan.cc/Projects/GaN_DCDC_Converter/overview/\\" target=\\"_blank\\" rel=\\"noopener noreferrer\\"><img class=\\"pv-hw__img\\" alt=\\"\\" loading=\\"lazy\\" src=\\"/images/dcdc3500KHz.png\\"><span>3.5 MHz GaN converter</span></a><a class=\\"pv-hw__item\\" href=\\"https://docs.ihsan.cc/Projects/LorentzSolver/overview/\\" target=\\"_blank\\" rel=\\"noopener noreferrer\\"><img class=\\"pv-hw__img\\" alt=\\"\\" loading=\\"lazy\\" src=\\"/images/solverImage1.png\\"><span>Lorentz E&amp;M solver</span></a><a class=\\"pv-hw__item\\" href=\\"https://docs.ihsan.cc/Projects/USB-CTriggerBoards/Rev1/overview/\\" target=\\"_blank\\" rel=\\"noopener noreferrer\\"><img class=\\"pv-hw__img\\" alt=\\"\\" loading=\\"lazy\\" src=\\"/images/usb_c_trigger_board.jpg\\"><span>USB‑C trigger board</span></a><a class=\\"pv-hw__item\\" href=\\"https://docs.ihsan.cc/Projects/LEDLightPanels/WIWO_Light/overview/\\" target=\\"_blank\\" rel=\\"noopener noreferrer\\"><img class=\\"pv-hw__img\\" alt=\\"\\" loading=\\"lazy\\" src=\\"/images/quad_high_power_floodlight.jpg\\"><span>Quad LED floodlight</span></a><a class=\\"pv-hw__item\\" href=\\"https://docs.ihsan.cc/Projects/BusinessCard/Rev2/overview/\\" target=\\"_blank\\" rel=\\"noopener noreferrer\\"><img class=\\"pv-hw__img\\" alt=\\"\\" loading=\\"lazy\\" src=\\"/images/usb_business_card.jpg\\"><span>RP2040 business card</span></a></div></section></main>"`;
